{
  "name": "iran-map",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run package:sync",
    "prebuild": "npm run package:sync",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "maps:normalize": "node scripts/normalize-map-data.mjs",
    "maps:simplify": "node scripts/simplify-map-data.mjs",
    "maps:topology": "node scripts/build-topology.mjs",
    "maps:index": "node scripts/build-search-index.mjs",
    "maps:build": "node scripts/build-map-data.mjs",
    "test": "node --experimental-strip-types --test tests/**/*.test.mjs",
    "test:e2e": "playwright test",
    "package:build": "npm --prefix packages/iran-vector-maps run build",
    "data:build": "npm --prefix packages/iran-vector-maps-data run build",
    "package:pack": "npm pack ./packages/iran-vector-maps",
    "data:pack": "npm pack ./packages/iran-vector-maps-data",
    "package:sync": "node scripts/sync-package-info.mjs"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "iran-vector-maps": "file:packages/iran-vector-maps",
    "lucide-react": "^1.49.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "topojson-client": "^3.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "topojson-server": "^3.0.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  }
}
